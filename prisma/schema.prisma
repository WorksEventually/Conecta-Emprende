generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────────────
// Enums
// ──────────────────────────────────────────────────────────

enum Role {
  USER
  PROVIDER
  ADMIN
  ADMIN_REVIEWER
  SUPER_ADMIN
}

enum ProviderStatus {
  DRAFT
  ACTIVE
  INACTIVE
  TEMPORARILY_RESTRICTED
  SUSPENDED
  BANNED
}

enum LegacyCity {
  MANAGUA
  LEON
  GRANADA
  MASAYA
  ESTELI
  MATAGALPA
  BLUEFIELDS
  JUIGALPA
  NAGAROTE
  SAN_JUAN_DE_ORIENTE

  @@map("LegacyCity")
}

enum FormalizationStatus {
  INFORMAL
  EN_PROCESO
  MIPYME_FORMAL
  DOCUMENTOS_PENDIENTES
}

enum Availability {
  DISPONIBLE
  OCUPADO
  BAJO_PEDIDO
  NO_DISPONIBLE_TEMPORALMENTE
}

// ──────────────────────────────────────────────────────────
// Auth Core
// ──────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  role          Role      @default(USER)
  password      String?
  emailVerified DateTime?
  isSynthetic Boolean @default(false)
  collusionConfirmed Boolean @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts                Account[]
  sessions                Session[]
  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]

  sentQuotes          QuoteThread[] @relation("Sender")
  reviews             Review[]      @relation("Reviewer")
  reviewedRiskReports RiskReport[]  @relation("RiskReportReviewer")

  providers             Provider[]
  roleAssignments       RoleAssignment[]
  moderationAuditLogs   ModerationAuditLog[] @relation("ModerationAuditActor")
  requestedModerationActions ModerationActionApproval[] @relation("ModerationApprovalRequester")
  approvedModerationActions ModerationActionApproval[] @relation("ModerationApprovalApprover")
  providerStatusUpdates Provider[]           @relation("ProviderStatusUpdatedBy")
  escalatedRiskReports  RiskReport[]         @relation("RiskReportEscalatedBy")
  resolvedRiskReports   RiskReport[]         @relation("RiskReportResolvedBy")
  requestEventActions   RequestEvent[]       @relation("RequestEventActions")
  invalidatedReputationEvents ReputationEvent[] @relation("ReputationEventInvalidator")
  privateFeedbackAuthored   ProviderPrivateFeedback[] @relation("PrivateFeedbackAuthor")
  privateFeedbackHistoryAuthored ProviderPrivateFeedbackHistory[] @relation("PrivateFeedbackHistoryAuthor")
}

model RoleAssignment {
  id        String   @id @default(cuid())
  userId    String
  role      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([role])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionToken String   @unique
  expires      DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([sessionToken])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime

  @@index([userId])
  @@index([token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime

  @@index([userId])
  @@index([token])
}

// ──────────────────────────────────────────────────────────
// Normalized reference data
// ──────────────────────────────────────────────────────────

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  cities    City[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model City {
  id           String        @id @default(cuid())
  departmentId String
  department   Department    @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  name         String
  slug         String        @unique
  legacyCode   LegacyCity?   @unique
  providers    Provider[]    @relation("ProviderCity")
  catalogItems CatalogItem[] @relation("CatalogItemCity")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([departmentId, name])
  @@index([departmentId])
}

model Category {
  id               String                @id @default(cuid())
  name             String
  slug             String                @unique
  parentCategoryId String?
  parentCategory   Category?             @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id])
  childCategories  Category[]            @relation("CategoryHierarchy")
  providerLinks    ProviderCategory[]
  catalogItemLinks CatalogItemCategory[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([parentCategoryId])
}

// ──────────────────────────────────────────────────────────
// Provider (un usuario puede tener múltiples negocios)
// ──────────────────────────────────────────────────────────

model Provider {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  riskLineageRootId String?
  riskLineageRoot   Provider?  @relation("ProviderRiskLineage", fields: [riskLineageRootId], references: [id], onDelete: SetNull)
  riskLineageMembers Provider[] @relation("ProviderRiskLineage")

  displayName   String
  slug          String  @unique
  bio           String? @db.Text
  logoUrl       String?
  coverImageUrl String?

  city          LegacyCity
  cityId        String?
  cityRef       City?      @relation("ProviderCity", fields: [cityId], references: [id], onDelete: SetNull)
  department    String?
  serviceRadius String?

  // category = categoría principal, mainCategory = categoría más específica
  category      String
  mainCategory  String?
  subcategories String[]

  priceMin        Int?
  priceMax        Int?
  priceRange      String?
  businessHours   String?
  deliveryOptions String[]

  availability        Availability        @default(DISPONIBLE)
  status              ProviderStatus      @default(DRAFT)
  statusReason        String?             @db.Text
  suspendedUntil      DateTime?
  statusUpdatedAt     DateTime?
  statusUpdatedById   String?
  statusUpdatedBy     User?               @relation("ProviderStatusUpdatedBy", fields: [statusUpdatedById], references: [id], onDelete: SetNull)
  verified            Boolean             @default(false)
  verificationLevel   String? // "Perfil completo", "Teléfono verificado", "Documento verificado"
  formalizationStatus FormalizationStatus @default(INFORMAL)
  profileCompleteness Float               @default(0)
  responseTimeHrs     Float?
  completedRequests   Int                 @default(0)

  // Coordenadas - lat/lng simple para Leaflet
  // PostGIS location disponible si se habilita extensión (requiere Privilegios de superuser)
  lat Float?
  lng Float?

  shortDescription String? @db.VarChar(200)
  aboutDescription String? @db.Text

  createdAt DateTime @default(now())
  activatedAt DateTime?
  updatedAt DateTime @updatedAt

  trustScore          TrustScore?
  metrics             ProviderMetrics?
  reviews             Review[]                 @relation("Reviewee")
  quoteThreads        QuoteThread[]            @relation("Provider")
  checklistState      FormalizationChecklist?
  formalizationSteps  FormalizationStep[]
  businessHourRows    ProviderBusinessHour[]
  deliveryOptionRows  ProviderDeliveryOption[]
  photos              ProviderPhoto[]
  catalogItems        CatalogItem[]
  medals              ProviderMedal[]
  categoryLinks       ProviderCategory[]
  trustScoreSnapshots TrustScoreSnapshot[]
  riskReports         RiskReport[]
  riskSignalEvidence  RiskSignalEvidence[]
  reputationEvents    ReputationEvent[]
  privateFeedback     ProviderPrivateFeedback[]

  @@index([city])
  @@index([cityId])
  @@index([category])
  @@index([mainCategory])
  @@index([availability])
  @@index([status])
  @@index([statusUpdatedById])
  @@index([userId])
  @@index([riskLineageRootId])
  @@index([slug])
}

model ProviderCategory {
  providerId String
  categoryId String
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([providerId, categoryId])
  @@index([categoryId])
  @@index([isPrimary])
}

model ProviderBusinessHour {
  id         String   @id @default(cuid())
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  dayOfWeek  Int
  opensAt    String?
  closesAt   String?
  isClosed   Boolean  @default(false)
  note       String?

  @@unique([providerId, dayOfWeek])
  @@index([providerId])
}

model ProviderDeliveryOption {
  id         String   @id @default(cuid())
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  label      String
  details    String?
  createdAt  DateTime @default(now())

  @@unique([providerId, label])
  @@index([providerId])
}

model ProviderPhoto {
  id            String   @id @default(cuid())
  providerId    String
  provider      Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  catalogItemId String?
  imageUrl      String
  caption       String?
  photoType     String // PRODUCTO | SERVICIO_REALIZADO | TALLER_O_LOCAL | EQUIPO_PRODUCTIVO | ENTREGA | PORTAFOLIO
  isFeatured    Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([providerId])
}

// ──────────────────────────────────────────────────────────
// Medals (spec §16)
// ──────────────────────────────────────────────────────────

model ProviderMedal {
  id          String   @id @default(cuid())
  providerId  String
  provider    Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  medalType   String // PERFIL_COMPLETO | TELEFONO_VERIFICADO | RESPONDE_RAPIDO | BUENAS_RESENAS | SOLICITUDES_COMPLETADAS | EQUIPO_PRODUCTIVO_DISPONIBLE | EN_PROCESO_DE_FORMALIZACION
  earnedAt    DateTime @default(now())
  sourceEvent String // descripción del evento que generó la medal

  @@index([providerId])
}

// ──────────────────────────────────────────────────────────
// Trust & Reviews
// ──────────────────────────────────────────────────────────

model TrustScore {
  id                 String   @id @default(cuid())
  providerId         String   @unique
  provider           Provider @relation(fields: [providerId], references: [id])
  scoreCompleteness  Float
  scoreTransactions  Float
  scoreResponseTime  Float
  scoreReviews       Float
  scoreFormalization Float
  finalScore         Float
  algorithmVersion   String   @default("v1-rule-based")
  features           Json?
  computedAt         DateTime @default(now())

  @@index([finalScore])
}

model ProviderMetrics {
  id                        String   @id @default(cuid())
  providerId                String   @unique
  provider                  Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  avgRating                 Float?
  totalVerifiedReviews      Int      @default(0)
  profileCompleteness       Float    @default(0)
  responseTimeHrs           Float?
  completedRequests         Int      @default(0)
  requestsResponded         Int      @default(0)
  suspiciousActivityPenalty Float    @default(0)
  trustScore                Float    @default(0)
  publicTrustScore          Float?
  evidenceLevel             String   @default("INSUFFICIENT_EVIDENCE")
  publicScoreFrozen         Boolean  @default(false)
  growthHold                Boolean  @default(false)
  algorithmVersion          String   @default("trust-v2.0.0")
  bilateralCompletions      Int      @default(0)
  uniqueRequesters          Int      @default(0)
  lastRecalculatedAt        DateTime?
  calculatedAt              DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@index([trustScore])
  @@index([avgRating])
}

model Review {
  id         String       @id @default(cuid())
  providerId String
  provider   Provider     @relation("Reviewee", fields: [providerId], references: [id])
  reviewerId String
  reviewer   User         @relation("Reviewer", fields: [reviewerId], references: [id])
  requestId  String
  request    QuoteThread @relation("RequestReviews", fields: [requestId], references: [id], onDelete: Cascade)

  qualityScore       Int
  responseTimeScore  Int
  fulfillmentScore   Int
  communicationScore Int
  valueScore         Int
  generalScore       Float

  comment   String?         @db.Text
  sentiment Float?
  analysis  ReviewAnalysis?
  history   ReviewHistory[]
  weight    Float           @default(1.0)
  editedAt  DateTime?
  createdAt DateTime        @default(now())

  @@unique([requestId, providerId, reviewerId])
  @@index([providerId])
  @@index([reviewerId])
  @@index([requestId])
  @@index([weight])
}

model ReviewHistory {
  id         String @id @default(cuid())
  reviewId   String
  review     Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  qualityScore       Int
  responseTimeScore  Int
  fulfillmentScore   Int
  communicationScore Int
  valueScore         Int
  generalScore       Float
  comment            String? @db.Text
  editedAt           DateTime @default(now())
  editedByUserId     String

  @@index([reviewId])
}

model ReviewAnalysis {
  id               String   @id @default(cuid())
  reviewId         String   @unique
  review           Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  sentimentScore   Float?
  qualitySignals   Json?
  moderationFlags  Json?
  generalScore     Float?
  algorithmVersion String   @default("v1-seeded")
  calculatedAt     DateTime @default(now())
}

model TrustScoreSnapshot {
  id                        String   @id @default(cuid())
  providerId                String
  provider                  Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  profileCompleteScore      Float
  contactVerifiedScore      Float
  requestsRespondedScore    Float
  requestsCompletedScore    Float
  avgReviewScore            Float
  responseTimeScore         Float
  accountAgeFactor          Float
  suspiciousActivityPenalty Float
  finalScore                Float
  publicScore               Float?
  evidenceLevel             String   @default("INSUFFICIENT_EVIDENCE")
  breakdown                 Json?
  caps                      Json?
  algorithmVersion          String   @default("v1-rule-based")
  calculatedAt              DateTime @default(now())

  @@index([providerId])
  @@index([calculatedAt])
  @@index([finalScore])
}

model RiskReport {
  id                            String    @id @default(cuid())
  providerId                    String
  provider                      Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  riskScore                     Float
  riskLevel                     String    @default("normal")
  penalty                       Int       @default(0)
  algorithmVersion              String    @default("risk-v1.0.0")
  suspiciousCyclesCount         Int       @default(0)
  avgSearchTimeSeconds          Float?
  avgRequestToCompletionMinutes Float?
  avgMessagesPerRequest         Float?
  newAccountsPercentage         Float?
  ratingConcentrationScore      Float?
  status                        String    @default("OPEN")
  reviewerNotes                 String?   @db.Text
  recommendedAction             String?
  generatedAt                   DateTime  @default(now())
  reviewedAt                    DateTime?
  reviewedByUserId              String?
  reviewedBy                    User?     @relation("RiskReportReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  escalatedAt                   DateTime?
  escalatedByUserId             String?
  escalatedBy                   User?     @relation("RiskReportEscalatedBy", fields: [escalatedByUserId], references: [id], onDelete: SetNull)
  resolvedAt                    DateTime?
  resolvedByUserId              String?
  resolvedBy                    User?     @relation("RiskReportResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  signalEvidence                RiskSignalEvidence[]
  reputationEvents              ReputationEvent[]
  moderationApprovals           ModerationActionApproval[]

  @@index([providerId])
  @@index([status])
  @@index([reviewedByUserId])
  @@index([escalatedByUserId])
  @@index([resolvedByUserId])
  @@index([providerId, status, generatedAt])
}

model RiskSignalEvidence {
  id              String      @id @default(cuid())
  providerId      String
  provider        Provider    @relation(fields: [providerId], references: [id], onDelete: Cascade)
  riskReportId    String?
  riskReport      RiskReport? @relation(fields: [riskReportId], references: [id], onDelete: SetNull)
  signalKey       String
  observedValue   Float?
  threshold       Float?
  contribution    Float
  windowStart     DateTime
  windowEnd       DateTime
  sourceEventIds  Json?
  sourceRecordIds Json?
  algorithmVersion String
  createdAt       DateTime    @default(now())

  @@index([providerId, createdAt])
  @@index([providerId, signalKey, createdAt])
  @@index([riskReportId])
  @@index([algorithmVersion])
}

model ModerationAuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  actor       User     @relation("ModerationAuditActor", fields: [actorUserId], references: [id], onDelete: Cascade)
  action      String
  targetType  String
  targetId    String
  reason      String   @db.Text
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model ModerationActionApproval {
  id                String   @id @default(cuid())
  action            String
  targetType        String
  targetId          String
  riskReportId      String?
  riskReport        RiskReport? @relation(fields: [riskReportId], references: [id], onDelete: SetNull)
  requestedByUserId String
  requestedBy       User     @relation("ModerationApprovalRequester", fields: [requestedByUserId], references: [id], onDelete: Cascade)
  approvedByUserId  String?
  approvedBy        User?    @relation("ModerationApprovalApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  status            String   @default("PENDING")
  reason            String   @db.Text
  suspendedUntil    DateTime?
  requestedAt       DateTime @default(now())
  approvedAt        DateTime?
  expiresAt         DateTime

  @@index([targetType, targetId, status])
  @@index([riskReportId])
  @@index([requestedByUserId, status])
  @@index([approvedByUserId])
  @@index([expiresAt])
}

// ──────────────────────────────────────────────────────────
// Catalog Items
// ──────────────────────────────────────────────────────────

model CatalogItem {
  id         String   @id @default(cuid())
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  title       String
  itemType    String // PRODUCTO_FINAL | SERVICIO_ESPECIALIZADO | INSUMO | MATERIA_PRIMA | EQUIPO_PRODUCTIVO | ALQUILER_EQUIPO | REPARACION_MANTENIMIENTO | CAPACITACION
  category    String
  subcategory String
  description String  @db.Text
  priceMin    Int?
  priceMax    Int?
  currency    String  @default("NIO")
  priceUnit   String? // "unidad", "día", "proyecto", "mes"

  city               String
  cityId             String?
  cityRef            City?        @relation("CatalogItemCity", fields: [cityId], references: [id], onDelete: SetNull)
  availabilityStatus Availability @default(DISPONIBLE)
  deliveryAvailable  Boolean      @default(false)
  pickupAvailable    Boolean      @default(false)
  mainImageUrl       String?

  viewCount    Int @default(0)
  inquiryCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  equipmentDetail EquipmentDetail?
  photos          CatalogItemPhoto[]
  categoryLinks   CatalogItemCategory[]
  metrics         CatalogItemMetrics?

  @@index([providerId])
  @@index([cityId])
  @@index([category])
  @@index([itemType])
}

model CatalogItemCategory {
  catalogItemId String
  categoryId    String
  isPrimary     Boolean  @default(false)
  createdAt     DateTime @default(now())

  catalogItem CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([catalogItemId, categoryId])
  @@index([categoryId])
  @@index([isPrimary])
}

model CatalogItemMetrics {
  id            String      @id @default(cuid())
  catalogItemId String      @unique
  catalogItem   CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  viewCount     Int         @default(0)
  inquiryCount  Int         @default(0)
  requestCount  Int         @default(0)
  calculatedAt  DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model EquipmentDetail {
  id                   String      @id @default(cuid())
  catalogItemId        String      @unique
  catalogItem          CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  modality             String // VENTA | ALQUILER | REPARACION | MANTENIMIENTO | INSTALACION | CAPACITACION_USO
  brand                String?
  model                String?
  condition            String?
  capacity             String?
  requiresTraining     Boolean     @default(false)
  includesInstallation Boolean     @default(false)
  maintenanceAvailable Boolean     @default(true)
}

model CatalogItemPhoto {
  id            String      @id @default(cuid())
  catalogItemId String
  catalogItem   CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  imageUrl      String
  caption       String?
  isFeatured    Boolean     @default(false)
  createdAt     DateTime    @default(now())

  @@index([catalogItemId])
}

// ──────────────────────────────────────────────────────────
// Quotes / Requests
// ──────────────────────────────────────────────────────────

model QuoteThread {
  id            String   @id @default(cuid())
  senderId      String
  sender        User     @relation("Sender", fields: [senderId], references: [id])
  providerId    String
  provider      Provider @relation("Provider", fields: [providerId], references: [id])
  catalogItemId String?

  // Compatibilidad con frontend legacy
  subject      String
  clientName   String? // display name del cliente (se deriva de sender si null)
  clientAvatar String? // avatar abbreviation
  dateLabel    String? // "Ayer", "Hace 1 semana" - calculado en app

  status String @default("OPEN") // OPEN | IN_CONVERSATION | COMPLETED | CLOSED_REQUESTER | CLOSED_PROVIDER | CANCELLED
  // ⚠️ DEPRECADO — mantener temporalmente para compatibilidad durante migración.
  // Usar workflow_phase/closure_outcome en su lugar.

  // ═══════════════════════════════════════════════════════
  // Modelo de 3 Ejes (Sprint 1 - Tarea 1.3)
  // ═══════════════════════════════════════════════════════
  workflow_phase   WorkflowPhase   @default(OPEN)
  closure_outcome  ClosureOutcome?
  moderation_state ModerationState @default(CLEAN)
  completionDeadline DateTime?
  // ═══════════════════════════════════════════════════════

  // Quote fields
  quotedPriceLabel       String?
  quotedDeliveryTime     String?

  // Historial de cotizaciones (auditoría completa, no sobrescribir)
  quotationHistory   Json? @default("[]") // JSON array: [{price, delivery, providerId, timestamp}]
  // Evento de aceptación de precio por el cliente (traza de acuerdo)
  acceptedQuotation  Json? // {price, delivery, acceptedAt, acceptedBy} | null

  confirmedByRequesterAt DateTime?
  confirmedByProviderAt  DateTime?
  completedAt            DateTime?

  version Int @default(1)
  cycleNo Int @default(0)

  // Sprint 6: Campos para rechazo/withdrawal del cierre (P2 §4.3, §4.4)
  completionInitiatorUserId   String?   @map("completion_initiator_user_id")
  completionRejectedAt        DateTime? @map("completion_rejected_at")
  completionRejectedByUserId  String?   @map("completion_rejected_by_user_id")
  lastNonSystemicMessageAt    DateTime? @map("last_nonsystemic_message_at")

  messages         QuoteMessage[]
  quoteOffers      QuoteOffer[]
  reviews          Review[]            @relation("RequestReviews")
  requestEvents    RequestEvent[]
  reputationEvents ReputationEvent[]   @relation("RequestReputationEvents")
  privateFeedback  ProviderPrivateFeedback?
  createdAt        DateTime            @default(now())

  @@index([senderId])
  @@index([providerId])
  @@index([status])
  @@index([workflow_phase])
  @@index([completionDeadline])
}

model ProviderPrivateFeedback {
  id          String      @id @default(cuid())
  requestId   String      @unique
  request     QuoteThread @relation(fields: [requestId], references: [id], onDelete: Cascade)
  providerId  String
  provider    Provider    @relation(fields: [providerId], references: [id], onDelete: Cascade)
  authorId    String
  author      User        @relation("PrivateFeedbackAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  history     ProviderPrivateFeedbackHistory[]
  note        String      @db.Text
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([providerId])
  @@index([authorId])
}

model ProviderPrivateFeedbackHistory {
  id         String      @id @default(cuid())
  feedbackId String
  feedback   ProviderPrivateFeedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  authorId   String
  author     User        @relation("PrivateFeedbackHistoryAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  note       String      @db.Text
  recordedAt DateTime    @default(now())

  @@index([feedbackId, recordedAt])
  @@index([authorId])
}

model QuoteOffer {
  id                String      @id @default(cuid())
  requestId         String
  request           QuoteThread @relation(fields: [requestId], references: [id], onDelete: Cascade)
  providerId        String
  amount            Int?
  currency          String      @default("NIO")
  priceLabel        String?
  deliveryTimeLabel String?
  notes             String?     @db.Text
  status            String      @default("DRAFT")
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([requestId])
  @@index([providerId])
  @@index([status])
}

model QuoteMessage {
  id             String      @id @default(cuid())
  threadId       String
  thread         QuoteThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId       String
  authorRole     String // "client" | "provider" | "system"
  body           String      @db.Text
  aiDrafted      Boolean     @default(false)
  approvedByUser Boolean     @default(true)
  createdAt      DateTime    @default(now())

  @@index([threadId])
}

model RequestEvent {
  id                 String           @id @default(cuid())
  requestId          String
  request            QuoteThread      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  eventType          RequestEventType
  actorUserId        String?
  actor              User?            @relation("RequestEventActions", fields: [actorUserId], references: [id], onDelete: SetNull)
  completionCycleNo  Int              @default(0)
  idempotencyKey     String           @unique
  metadataJson       Json?
  occurredAt         DateTime         @default(now())
  createdAt          DateTime         @default(now())

  reputationEvents   ReputationEvent[]

  @@index([requestId, occurredAt])
  @@index([eventType])
  @@index([idempotencyKey])
}

enum EvidenceType {
  BILATERAL_COMPLETION
  UNILATERAL_REVIEW_QUALIFIED
  UNILATERAL_REVIEW_UNQUALIFIED
  CONTACT_CONFIRMATION
  PENALTY_SUSPICIOUS_ACTIVITY
  PENALTY_POLICY_VIOLATION
}

model ReputationEvent {
  id                   String        @id @default(cuid())
  providerId           String
  provider             Provider      @relation(fields: [providerId], references: [id], onDelete: Cascade)
  requestId            String?
  request              QuoteThread?  @relation("RequestReputationEvents", fields: [requestId], references: [id], onDelete: SetNull)
  evidenceType         EvidenceType
  evidenceWeight       Float
  sourceEventId        String?
  sourceEvent          RequestEvent? @relation(fields: [sourceEventId], references: [id], onDelete: SetNull)
  riskReportId         String?
  riskReport           RiskReport?   @relation(fields: [riskReportId], references: [id], onDelete: SetNull)
  algorithmVersion     String        @default("trust-v2.0.0")
  invalidatedAt        DateTime?
  invalidatedByAdminId String?
  invalidatedByAdmin   User?         @relation("ReputationEventInvalidator", fields: [invalidatedByAdminId], references: [id], onDelete: SetNull)
  invalidationReason   String?       @db.Text
  createdAt            DateTime      @default(now())

  @@unique([requestId, evidenceType])
  @@index([providerId, createdAt])
  @@index([evidenceType])
  @@index([algorithmVersion])
  @@index([sourceEventId])
  @@index([riskReportId])
  @@unique([riskReportId, evidenceType])
}

// ──────────────────────────────────────────────────────────
// Formalization
// ──────────────────────────────────────────────────────────

model FormalizationChecklist {
  id         String   @id @default(cuid())
  providerId String   @unique
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  steps      Json // [{id, title, description, status: "completed" | "current" | "pending"}]
  updatedAt  DateTime @updatedAt
}

model FormalizationStep {
  id          String    @id @default(cuid())
  providerId  String?
  provider    Provider? @relation(fields: [providerId], references: [id], onDelete: Cascade)
  code        String
  title       String
  description String?   @db.Text
  sortOrder   Int       @default(0)
  isRequired  Boolean   @default(false)
  status      String    @default("ROADMAP")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([providerId, code])
  @@index([providerId])
  @@index([sortOrder])
}

// ──────────────────────────────────────────────────────────
// Modelo de 3 Ejes para Solicitudes de Cotización (Sprint 1)
// ──────────────────────────────────────────────────────────

enum WorkflowPhase {
  OPEN // Solicitud activa, sin cierre solicitado
  COMPLETION_PENDING // Una o ambas partes confirmaron; esperando 72h
  CLOSED // Cerrado definitivamente
}

enum ClosureOutcome {
  BILATERAL // Ambos confirmaron < 72h
  REQUESTER_CONFIRMED_PROVIDER_NO_RESPONSE // Cliente confirmó, proveedor timeout
  PROVIDER_CLAIMED_REQUESTER_NO_RESPONSE // Proveedor confirmó, cliente timeout
  CANCELLED_BY_REQUESTER // Cliente canceló explícitamente
  CANCELLED_BY_PROVIDER // Proveedor canceló explícitamente sin interacción previa
  CANCELLED_BY_PROVIDER_AFTER_ENGAGEMENT // Proveedor canceló tras interacción (habilita reseña peso 0.5)
  MODERATION_CLOSURE // Cerrado por acción de moderación
  DECLINED_BY_PROVIDER // Sprint 6: Proveedor rechaza ANTES de interactuar
  EXPIRED_NO_PROVIDER_RESPONSE // Sprint 6: Nadie respondió jamás
  ACCOUNT_DEACTIVATED // Sprint 6: Cuenta desactivada durante interacción
  CLOSED_BY_ADMIN // Sprint 6: Cierre administrativo
}

enum ModerationState {
  CLEAN // Sin flags
  FLAGGED // Bajo revisión de moderación
  RESTRICTED // Restringido por moderación
}

enum RequestEventType {
  REQUEST_CREATED
  PROVIDER_RESPONDED
  QUOTE_ACCEPTED
  COMPLETION_REQUESTED
  COMPLETION_CONFIRMED
  COMPLETION_TIMEOUT
  CANCELLED_BY_REQUESTER
  CANCELLED_BY_PROVIDER
  MODERATION_FLAG
  MODERATION_CLOSURE
  REOPENED
  MESSAGE_SENT
  DEADLINE_EXTENDED
  ADMIN_OVERRIDE
  COMPLETION_NOT_ACCEPTED // Sprint 6: Rechazo del cierre (P2 §4.3)
  COMPLETION_REQUEST_WITHDRAWN // Sprint 6: Retiro del cierre (P2 §4.4)
  REQUEST_DECLINED // Sprint 6: Proveedor rechaza solicitud
  REQUEST_EXPIRED // Sprint 6: Expiración sin respuesta
}

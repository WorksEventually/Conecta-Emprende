# Database
DATABASE_URL="postgresql://postgres:changeme@localhost:5432/conecta_emprende"
POSTGRES_DB="conecta_emprende"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="changeme"
POSTGRES_PORT="5432"

# JWT Secrets (generate with: openssl rand -base64 64)
JWT_SECRET="your-jwt-secret-min-32-chars-here"
JWT_REFRESH_SECRET="your-refresh-secret-min-32-chars-here"

# Token Expiry
ACCESS_TOKEN_EXPIRY="15m"
REFRESH_TOKEN_EXPIRY="7d"

# OAuth Google
# 1. Crear proyecto en https://console.cloud.google.com
# 2. APIs y servicios → Pantalla de consentimiento de OAuth → Tipo: Externo
# 3. Credenciales → Crear credencial → ID de cliente de OAuth → Tipo: Aplicación web
# 4. URIs de redirección autorizados (debe coincidir EXACTO con ${APP_URL}/api/auth/google/callback):
#    http://localhost:3000/api/auth/google/callback
# 5. Copiar aquí el Client ID y el Client Secret generados
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# App
APP_URL="http://localhost:3000"
NODE_ENV="development"
APP_PORT="3000"

# Developer-only manual profile switcher. Keep false in production.
VITE_ENABLE_DEMO_PROFILE_SWITCHER=false

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

